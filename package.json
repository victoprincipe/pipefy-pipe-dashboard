{
  "name": "pipelens-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flexible analytics dashboard & chart builder Pipefy App built with Pipefy SDK, Web Workers, hybrid bulk/incremental sync, and strict per-user caching.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "start": "node server/index.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:4173",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
